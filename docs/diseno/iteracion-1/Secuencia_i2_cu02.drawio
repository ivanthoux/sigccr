 casos (A1, A5)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontFamily=Arial;fontSize=11;whiteSpace=wrap;" edge="1" parent="1"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="480.0" y="810" as="sourcePoint"/><mxPoint x="290.0" y="810" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s25" value="15: abre el enlace y define la contraseña" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;whiteSpace=wrap;" edge="1" parent="1"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="100.0" y="866" as="sourcePoint"/><mxPoint x="290.0" y="866" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s26" value="16: POST restablecer con el código" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;whiteSpace=wrap;" edge="1" parent="1"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="290.0" y="922" as="sourcePoint"/><mxPoint x="480.0" y="922" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s27" value="17: restablecer(código, contraseña, confirmación)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;whiteSpace=wrap;" edge="1" parent="1"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="480.0" y="978" as="sourcePoint"/><mxPoint x="670.0" y="978" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s28" value="18: PoliticaContrasena, de 15 a 128 caracteres y no comprometida" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;whiteSpace=wrap;align=left;spacingLeft=4;" edge="1" parent="1"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="670.0" y="1034" as="sourcePoint"/><mxPoint x="670.0" y="1056" as="targetPoint"/><Array as="points"><mxPoint x="710.0" y="1034"/><mxPoint x="710.0" y="1056"/></Array></mxGeometry></mxCell><mxCell id="s29" value="19: buscarVigente(código) con UPDLOCK" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fon