@startuml
!include estilo.iuml
title CU-79 Confirmar Alternativa de Financiación (diagrama 1 de 3)
actor Analista as AN
participant ":Alternativas" as C <<control>>
participant ":EstructuracionService" as ES <<service>>
participant "Estructurador" as EB <<utility>>
participant ":SolicitudService" as SO <<service>>
participant ":AuditoriaService" as AU <<service>>
participant "db : BaseConnection" as DB
activate AN
AN -> C ++ : 1: confirmar(solicitudId, alternativaId, versionFila, fecha, medio de la conformidad)
C -> ES ++ : 1.1: r = confirmar(solicitudId, alternativaId, versionFila, datos, usuarioId)
group critical [transacción]
  ES -> ES : 1.1.1: s = solicitudPendienteDePlan(solicitudId)
  alt Si (s.versionFila ≠ versionFila)
    ES --> C : 1.1.2: ReglaNegocioException("la solicitud cambió", "RN-24")
  end
  ES -> ES : 1.1.3: ev = evaluacionVigente(solicitudId)
  alt Si (ev = null) (A5)
    ES -> DB ++ : 1.1.4: update(evaluación Vencida)
    deactivate DB
    ES -> SO ++ : 1.1.5: cambiarEstado(s, "PendienteEvaluacion", usuarioId, motivo RN-20)
    deactivate SO
    ES -> AU ++ : 1.1.6: registrar("alternativas.confirmar", …, "Rechazado")
    deactivate AU
    ES --> C : 1.1.7: [PendienteEvaluacion, mensaje]
  end
  ES -> DB ++ : 1.1.8: a = query(alternativa, con bloqueo UPDLOCK)
  deactivate DB
  alt Si (a = null o a.estado ≠ "Vigente")
    ES --> C : 1.1.9: ReglaNegocioException("ya no está disponible", "RN-48")
  end
  ES -> EB ++ : 1.1.10: c = validarConformidad(datos, hoy, fechaGeneracion)
  deactivate EB
  alt Si (c.errores no está vacío)
    ES --> C : 1.1.11: ValidacionException(c.errores, "RN-23")
  else Si (a.vence ≤ ahora) (A2)
    ES -> DB ++ : 1.1.12: update(alternativa Vencida)
    deactivate DB
    ES --> C : 1.1.13: [PendienteSeleccionPlan, «superó su vigencia de 7 días»]
  end
  ref over ES, DB : 1.1.14: Revalidar la capacidad de pago (diagrama 2 de 3)
  ref over ES, DB : 1.1.15: r = Aprobar la solicitud (diagrama 3 de 3)
end
ES --> C -- : 1.1.16: r
C --> AN -- : 1.2: estado resultante y vencimiento de la aprobación
@enduml
