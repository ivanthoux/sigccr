@startuml
!include estilo.iuml
title CU-105 Generar Régimen Informativo de Deudores: consultar, descargar o rectificar (diagrama 2 de 3)
actor Gerente as GE
participant ":Regimen" as C <<control>>
participant ":RegimenService" as RS <<service>>
participant ":AuditoriaService" as AU <<service>>
participant "db : BaseConnection" as DB
activate GE
GE -> C ++ : 1: descargar(id)
C -> RS ++ : 1.1: a = archivo(id, usuarioId)
RS -> DB ++ : 1.1.1: r = query(período, versión y archivo del régimen)
deactivate DB
RS -> AU ++ : 1.1.2: registrar("regimen.descargar", "regimenes_informativos", id)
deactivate AU
RS --> C -- : 1.1.3: [nombre, contenido]
C --> GE -- : 1.2: descarga de regimen_deudores_<período>_v<n>.txt
GE -> C ++ : 2: generar(periodo, motivo): rectificación
C -> RS ++ : 2.1: r = generar(periodo, usuarioId, motivo)
ref over RS, DB : 2.1.1: Generar el régimen del período (diagrama 3 de 3)
RS --> C -- : 2.1.2: [id, version, deudores]
C --> GE -- : 2.2: versión nueva; la anterior queda Rectificada
@enduml
