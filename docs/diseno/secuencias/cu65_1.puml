@startuml
!include estilo.iuml
title CU-65 Generar Reporte de Cartera Crediticia (patrón de los reportes, diagrama 1 de 2)
actor Gerente as GE
participant ":Reportes" as C <<control>>
participant ":ReporteService" as RS <<service>>
participant "Periodo" as PE <<utility>>
participant "Indicadores" as IN <<utility>>
participant ":AuditoriaService" as AU <<service>>
participant "db : BaseConnection" as DB
activate GE
note over GE, C : Antes del controlador, el filtro verifica la sesión y el permiso reportes.cartera.
GE -> C ++ : 1: ver("cartera"): período, criterios y formato
C -> RS ++ : 1.1: r = generar("cartera", criterios, formato)
RS -> PE ++ : 1.1.1: p = desde(criterios, hoy): día, semana, mes, trimestre o rango
deactivate PE
alt Si (período incoherente)
  RS --> C : 1.1.2: ValidacionException(errores)
  C --> GE : 1.2: vuelve al formulario con los errores (A2)
end
RS -> RS : 1.1.3: cartera(p, criterios)
activate RS
RS -> DB ++ : 1.1.3.1: query(créditos, cuotas y saldos de solo lectura) (RN-47)
deactivate DB
RS -> IN ++ : 1.1.3.2: porcentaje(vencido, capitalPendiente) y tramo(dias): índice de morosidad, tramos y evolución (RN-74)
deactivate IN
deactivate RS
RS -> AU ++ : 1.1.4: registrar("reportes.cartera", "reportes", null, período, formato y filtros)
deactivate AU
RS --> C -- : 1.1.5: r: indicadores y secciones, con aviso si no hay datos (A1)
alt Si (formato = "xlsx")
  ref over C : 1.3: archivo = Exportar a Excel (diagrama 2 de 2)
  C --> GE : 1.4: descarga del .xlsx
else formato = "pantalla"
  C --> GE -- : 1.5: vista con impresión y PDF del navegador
end
@enduml
