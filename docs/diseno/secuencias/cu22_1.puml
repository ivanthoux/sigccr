@startuml
!include estilo.iuml
title CU-22 Registrar Solicitud de Crédito (diagrama 1 de 2)
actor Analista as AN
participant ":Solicitudes" as C
participant ":SolicitudService" as S
participant ":LegajoService" as L
participant ":AuditoriaService" as AU
participant "db : BaseConnection" as DB
activate AN
AN -> C ++ : 1: registrar(simulacionId, archivos)
C -> S ++ : 1.1: registrar(simulacionId, archivos, usuarioId)
S -> L ++ : 1.1.1: documentos = validarArchivos(archivos, errores)
deactivate L
alt Si (errores no está vacío)
  S --> C : 1.1.2: ValidacionException(errores)
  C --> AN : 1.2: formulario con cada error junto a su campo
end
group critical [transacción]
  ref over S, DB : 1.1.3: Validar la simulación, el cliente y la documentación\n(CU-22, diagrama 2 de 2)
  loop Mientras (haya documentos por guardar)
    S -> L ++ : 1.1.4: guardar(clienteId, unDocumento, usuarioId)
    deactivate L
  end
  S -> DB ++ : 1.1.5: id = insert("solicitudes_credito", PendienteVerificacion)
  deactivate DB
  S -> S : 1.1.6: registrarTransicion(id, null, "PendienteVerificacion")
  S -> S : 1.1.7: nuevaRevision(id, versionId)
  S -> AU ++ : 1.1.8: registrar("solicitudes.registrar", id)
  deactivate AU
end
opt Si (falla después de guardar documentos)
  S -> L : 1.1.9: descartar(movidos)
end
S --> C -- : 1.1.10: [id, numero]
C --> AN -- : 1.3: solicitud N.º numero registrada, pendiente de verificación
@enduml
