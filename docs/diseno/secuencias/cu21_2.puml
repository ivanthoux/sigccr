@startuml
!include estilo.iuml
title CU-21 Simular Crédito: consultar la simulación (diagrama 2 de 2)
actor Analista as AN
participant ":Simulaciones" as C <<control>>
participant ":SimulacionService" as S <<service>>
participant ":ParametroService" as PS <<service>>
participant "Simulador" as SI <<utility>>
participant "db : BaseConnection" as DB
activate AN
AN -> C ++ : 1: ver(id)
C -> S ++ : 1.1: s = obtener(id)
S -> DB ++ : 1.1.1: s = query(simulación con su línea, versión y vigencia)
deactivate DB
S -> S : 1.1.2: s.calculo = calculo(s, s.fechaGeneracion)
activate S
S -> PS ++ : 1.1.2.1: iva = vigente("Estructuracion", fechaGeneracion).alicuotaIva
deactivate PS
S -> SI ++ : 1.1.2.2: calcular(s, importe, cuotas, iva, fecha)
deactivate SI
deactivate S
S -> S : 1.1.3: s.exceso = excesoCapacidad(cliente(s.clienteId), s, cuotas, valorCuota)
activate S
S -> PS ++ : 1.1.3.1: p = vigente("Estructuracion")
deactivate PS
S -> SI ++ : 1.1.3.2: excesoCapacidad(version, cuotas, primeraCuota, perfil.capacidad, iva, paso, tope) (RN-18, D-65)
deactivate SI
deactivate S
S --> C -- : 1.1.4: s
alt Si (s.exceso ≠ null)
  C --> AN : 1.2: plan como referencia, aviso «Excede la capacidad de pago» con el importe máximo, sin «Registrar solicitud» (D-65)
else
  C --> AN -- : 1.3: plan preliminar paginado con discriminación por concepto y «Registrar solicitud»
end
@enduml
