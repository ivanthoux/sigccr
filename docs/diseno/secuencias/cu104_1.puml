@startuml
!include estilo.iuml
title CU-104 Pre-registrarse en el Portal: registrar los datos (diagrama 1 de 3)
actor "Persona interesada" as PI
participant ":PreRegistro" as C <<control>>
participant ":PreRegistroService" as S <<service>>
participant "ValidadorPreRegistro" as V <<utility>>
participant ":ComunicacionService" as CO <<service>>
participant ":AuditoriaService" as AU <<service>>
participant "db : BaseConnection" as DB
activate PI
PI -> C ++ : 1: registrar(datos, consentimientos, correo)
C -> S ++ : 1.1: registrar(datos, ip)
S -> V ++ : 1.1.1: d = normalizar(datos) y errores = validar(d): formato, CUIL, correo y consentimiento obligatorio
deactivate V
alt Si (errores no está vacío)
  S --> C : 1.1.2: ValidacionException(errores, "RN-64")
end
group critical [transacción]
  S -> DB ++ : 1.1.3: esCliente = query(cliente con ese documento o CUIT/CUIL) y correoUsado = query(cliente o cuenta con ese correo)
  deactivate DB
  alt Si (esCliente)
    S --> C : 1.1.4: ReglaNegocioException(«Usted ya es cliente: active su acceso con Activar mi acceso» (CU-04))
  else Si (correoUsado)
    S --> C : 1.1.5: ValidacionException(«Ese correo ya está registrado», "RN-08")
  end
  S -> DB ++ : 1.1.6: previo = query(pre-registro activo con esos datos)
  deactivate DB
  alt Si (previo.estado = "PendienteValidacion")
    S --> C : 1.1.7: ReglaNegocioException(«acérquese a la sucursal para completar el alta»)
  else Si (previo ≠ null: no verificado)
    S -> DB ++ : 1.1.8: update(pre-registro: datos nuevos, hash del código y vence en 30 min)
    deactivate DB
  else
    S -> DB ++ : 1.1.9: id = insert("pre_registros", PendienteVerificacion, hash SHA-256 del código, vence en 30 min)
    deactivate DB
  end
  S -> CO ++ : 1.1.10: comunicacionId = encolar("VerificacionCorreo", correo, "verificacion_pre_registro", enlace)
  deactivate CO
  S -> AU ++ : 1.1.11: registrar("pre-registros.registrar", "pre_registros", id)
  deactivate AU
end
S -> CO ++ : 1.1.12: enviar(comunicacionId)
deactivate CO
S --> C -- : 1.1.13:
C --> PI -- : 1.2: le enviamos un correo para verificar la dirección
@enduml
