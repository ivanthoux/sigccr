@startuml
!include estilo.iuml
title CU-01 Iniciar Sesión
actor "Usuario interno\no Cliente" as U
participant ":LimiteIntentosFilter" as F <<control>>
participant ":Acceso" as C <<control>>
participant ":AccesoService" as S <<service>>
participant ":ControlIntentos" as CI
participant ":AuditoriaService" as AU <<service>>
participant "db : BaseConnection" as DB
activate U
U -> F ++ : 1: before(request): POST de correo y contraseña
F -> F : 1.1: permitido = throttler.check(clave de la IP, 100, 15 min)
alt Si (no permitido)
  F -> AU ++ : 1.2: registrar("acceso.limite_origen", ruta)
  deactivate AU
  F --> U : 1.3: 429 Demasiados intentos (A4)
end
F -> C ++ : 1.4: autenticar()
deactivate F
C -> S ++ : 1.4.1: cuenta = autenticar(tipoCuenta, correo, contrasena)
group critical [transacción]
  S -> DB ++ : 1.4.1.1: cuenta = query(cuenta del correo, con bloqueo UPDLOCK)
  deactivate DB
  alt Si (cuenta = null)
    S -> S : 1.4.1.2: intentoSinCuenta(tipoCuenta, correo, control, ahora)
  else Si (cuenta.estado ≠ "Habilitada" o la contraseña no coincide)
    S -> CI ++ : 1.4.1.3: f = registrarFallo(intentos, inicioVentana, ahora)
    deactivate CI
    S -> DB ++ : 1.4.1.4: update(cuenta: intentos, ventana, estado, bloqueadaHasta)
    deactivate DB
    S -> AU ++ : 1.4.1.5: registrar("acceso.fallido" y, si f.bloquear, "acceso.bloqueo")
    deactivate AU
  else Si (cliente desactivado en el padrón o rol sin permisos)
    S -> AU ++ : 1.4.1.6: registrar("acceso.fallido", motivo) (RN-10, RN-01)
    deactivate AU
  else credenciales válidas
    S -> S : 1.4.1.7: permisos = permisosDelRol(rolId)
    S -> DB ++ : 1.4.1.8: update(cuenta: intentos = 0, ultimoAcceso, rehash Argon2id)
    deactivate DB
    S -> AU ++ : 1.4.1.9: registrar("acceso.inicio", id)
    deactivate AU
  end
end
note right of S : El intento fallido se confirma igual:\nla transacción no se revierte (RN-62).\nSin cuenta se verifica una contraseña\nde referencia y el contador va a la caché.
alt Si (el intento fue rechazado)
  S --> C : 1.4.2: ReglaNegocioException(mensaje genérico e intentos restantes)
  C --> U : 1.5: pantalla de acceso con el aviso (A1, A2)
else
  S --> C -- : 1.4.3: cuenta, rol, permisos, versionSeguridad
  C -> C : 1.4.4: session.regenerate(true) y set("cuenta", cuenta) (RNF-11)
  C --> U -- : 1.6: redirección a la pantalla principal
end
@enduml
