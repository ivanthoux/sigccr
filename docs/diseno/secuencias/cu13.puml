@startuml
!include estilo.iuml
title CU-13 Desactivar Cliente
actor "Analista de Crédito\no Gerente" as AN
participant ":Clientes" as C <<control>>
participant ":ClienteService" as S <<service>>
participant "ReglasClientes" as RC <<utility>>
participant ":AutorizacionService" as AZ <<service>>
participant ":AuditoriaService" as AU <<service>>
participant "db : BaseConnection" as DB
activate AN
AN -> C ++ : 1: confirmar(id, "desactivar")
C --> AN -- : 1.1: confirmación con la versionFila
AN -> C ++ : 2: desactivar(id, versionFila, motivo)
C -> S ++ : 2.1: desactivar(id, versionFila, motivo)
S -> S : 2.1.1: motivo = exigirMotivo(motivo)
group critical [transacción]
  S -> S : 2.1.2: c = bloquear("clientes", [id])
  S -> S : 2.1.3: p = pendientes(id): cuotas, solicitudes, propuestas, saldos a favor, órdenes y ofertas
  S -> RC ++ : 2.1.4: rechazos = motivosContraDesactivar(c.estado, p)
  deactivate RC
  alt Si (rechazos no está vacío)
    S --> C : 2.1.5: ReglaNegocioException(rechazos, "RN-09")
    C --> AN : 2.2: lo que debe resolverse antes
  end
  S -> S : 2.1.6: actualizarConVersion("clientes", id, versionFila, estado = "Desactivado")
  opt Si (c.cuentaClienteId ≠ null)
    S -> DB ++ : 2.1.7: update(cuenta Desactivada, versionSeguridad + 1)
    deactivate DB
    S -> AZ ++ : 2.1.8: sustituirVigentes(cuentaClienteId)
    deactivate AZ
  end
  S -> AU ++ : 2.1.9: registrarCambios("clientes.desactivar", "clientes", id, estado, motivo)
  deactivate AU
end
S --> C -- : 2.1.10:
C --> AN -- : 2.3: cliente desactivado
note over AN, S : En la siguiente petición del portal, AuthFilter compara la versionSeguridad\nde la sesión con la de la cuenta, cierra la sesión del cliente y lo envía a portal/login (RNF-11).
@enduml
