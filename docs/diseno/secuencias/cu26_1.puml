@startuml
!include estilo.iuml
title CU-26 Resolver Solicitud de Crédito Convencional (diagrama 1 de 2)
actor Gerente as GE
participant ":Resoluciones" as C <<control>>
participant ":ResolucionService" as R <<service>>
participant "ResolucionGerencial" as RG <<utility>>
participant ":FondosService" as F <<service>>
participant ":SolicitudService" as SO <<service>>
participant ":AuditoriaService" as AU <<service>>
participant "db : BaseConnection" as DB
activate GE
GE -> C ++ : 1: ver(id)
C -> R ++ : 1.1: a = antecedentes(id): legajo, evaluación, alternativas, capacidad y fondos
deactivate R
C --> GE -- : 1.2: antecedentes de la solicitud
GE -> C ++ : 2: resolver(id, versionFila, decisión, plan, fundamento)
C -> R ++ : 2.1: r = resolver(id, versionFila, datos, usuarioId)
group critical [transacción]
  R -> R : 2.1.1: s = bloquear("solicitudes_credito", [id])
  alt Si (s.estado ≠ "PendienteResolucion" o s.versionFila ≠ versionFila)
    R --> C : 2.1.2: ReglaNegocioException(mensaje, "RN-24")
  end
  R -> R : 2.1.3: confirmada = alternativaConfirmada(id)
  R -> RG ++ : 2.1.4: v = validar(datos, confirmada ≠ null) (RN-22)
  deactivate RG
  alt Si (v.errores no está vacío)
    R --> C : 2.1.5: ValidacionException(v.errores, "RN-22")
  end
  alt Si (decisión = "Rechazada") (A1)
    R -> DB ++ : 2.1.6: insert("resoluciones", Rechazada, fundamento)
    deactivate DB
    R -> F ++ : 2.1.7: liberarDeSolicitud(id)
    deactivate F
    R -> SO ++ : 2.1.8: cambiarEstado(s, "Rechazada", usuarioId, fundamento, tipoRechazo "Crediticio")
    deactivate SO
    R -> R : 2.1.9: cerrarAlertas(id)
  else Si (decisión = "DevueltaRevision") (A2)
    R -> DB ++ : 2.1.10: insert("resoluciones", DevueltaRevision, etapaRetorno)
    deactivate DB
    R -> F ++ : 2.1.11: liberarDeSolicitud(id)
    deactivate F
    R -> SO ++ : 2.1.12: cambiarEstado(s, "DevueltaRevision", usuarioId, fundamento)
    deactivate SO
    R -> R : 2.1.13: alertarAnalista(s, causa, "Registrar las correcciones (CU-84)")
  else decisión = "Aprobada"
    ref over R, DB : 2.1.14: Aprobar la solicitud (diagrama 2 de 2)
  end
  R -> AU ++ : 2.1.15: registrar("solicitudes.resolver", "solicitudes_credito", id, decisión)
  deactivate AU
end
R --> C -- : 2.1.16: [estado, mensaje]
C --> GE -- : 2.2: nuevo estado de la solicitud
@enduml
