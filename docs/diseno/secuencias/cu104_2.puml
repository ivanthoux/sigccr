@startuml
!include estilo.iuml
title CU-104 Pre-registrarse en el Portal: verificar el correo (diagrama 2 de 3)
actor "Persona interesada" as PI
participant ":PreRegistro" as C <<control>>
participant ":PreRegistroService" as S <<service>>
participant ":AlertaService" as AL <<service>>
participant ":AuditoriaService" as AU <<service>>
participant "db : BaseConnection" as DB
activate PI
PI -> C ++ : 2: verificar(codigo)
C -> S ++ : 2.1: verificar(codigo)
group critical [transacción]
  S -> DB ++ : 2.1.1: p = query(pre-registro por el hash del código, con bloqueo UPDLOCK)
  deactivate DB
  alt Si (p = null o vencido)
    S --> C : 2.1.2: ReglaNegocioException(«el enlace expiró o no es válido»)
  end
  S -> DB ++ : 2.1.3: update(pre-registro PendienteValidacion, sin código, con la fecha de verificación)
  deactivate DB
  S -> AL ++ : 2.1.4: generar("Operativa", «nuevo pre-registro», «completar el alta (CU-11)», AnalistaCredito)
  deactivate AL
  S -> AU ++ : 2.1.5: registrar("pre-registros.verificar", "pre_registros", id)
  deactivate AU
end
S --> C -- : 2.1.6:
C --> PI -- : 2.2: correo verificado: complete el alta en la sucursal
@enduml
