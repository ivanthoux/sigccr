digraph solicitud { rankdir=TB; compound=true; graph [fontname="Arial", fontsize=12, nodesep=0.5, ranksep=0.6, bgcolor=white];
node [fontname="Arial", fontsize=12, shape=box, style="rounded,filled", fillcolor="#DAE8FC", color="#6C8EBF", penwidth=1.5, height=0.45];
edge [fontname="Arial", fontsize=9, color="#333333", penwidth=1.2, arrowsize=0.8];
ini [shape=circle, style=filled, fillcolor=black, color=black, width=0.22, height=0.22, fixedsize=true, label=""];
subgraph cluster_t { label="En trámite"; labeljust=l; fontname="Arial Bold"; style="rounded,filled"; fillcolor="#F7F9FC"; color="#6C8EBF"; penwidth=1.5;
 PendienteVerificacion; PendienteDocumentacion; PendienteEvaluacion; EnEvaluacion; PendienteContingencia; PendienteResolucion; DevueltaRevision; PendienteSeleccionPlan; AprobadaPendienteLiquidacion;
 dec [shape=diamond, style=filled, fillcolor=white, color=black, width=0.35, height=0.35, fixedsize=true, label=""];
}
f1 [shape=doublecircle, style=filled, fillcolor=black, color=black, width=0.24, height=0.24, fixedsize=true, label=""];
f2 [shape=doublecircle, style=filled, fillcolor=black, color=black, width=0.24, height=0.24, fixedsize=true, label=""];
f3 [shape=doublecircle, style=filled, fillcolor=black, color=black, width=0.24, height=0.24, fixedsize=true, label=""];
f4 [shape=doublecircle, style=filled, fillcolor=black, color=black, width=0.24, height=0.24, fixedsize=true, label=""];
ini -> PendienteVerificacion [label="registro (CU-22) u\noferta aceptada (CU-52)"];
PendienteVerificacion -> PendienteDocumentacion [label="faltantes\nsubsanables (CU-23)"];
PendienteDocumentacion -> PendienteVerificacion [label="correcciones\n(CU-84)"];
PendienteVerificacion -> PendienteEvaluacion [label="documentación\nverificada (CU-23)"];
PendienteVerificacion -> Rechazada [label="rechazo documental\n(CU-23)"];
PendienteEvaluacion -> EnEvaluacion [label="inicio de evaluación\nautomática (CU-86)"];
EnEvaluacion -> PendienteEvaluacion [label="error interno o\ninterrupción (CU-86 A7, D-17)"];
EnEvaluacion -> PendienteSeleccionPlan [label="favorable (CU-86)"];
EnEvaluacion -> PendienteResolucion [label="requiere análisis gerencial\no sin alternativas (CU-86)"];
EnEvaluacion -> Rechazada [label="desfavorable\n(CU-86)"];
EnEvaluacion -> PendienteContingencia [label="no completada\n(CU-86)"];
EnEvaluacion -> PendienteVerificacion [label="cambio de documento clave\n(RN-61; también desde los\nestados posteriores)"];
PendienteContingencia -> PendienteResolucion [label="contingencia\nregistrada (CU-25)"];
PendienteSeleccionPlan -> AprobadaPendienteLiquidacion [label="alternativa confirmada\n[aprobación automática] (CU-79)"];
PendienteSeleccionPlan -> PendienteResolucion [label="alternativa confirmada\n[requiere Gerente] (CU-79)"];
PendienteResolucion -> AprobadaPendienteLiquidacion [label="aprobación (CU-26)"];
PendienteResolucion -> Rechazada [label="rechazo (CU-26)"];
PendienteResolucion -> DevueltaRevision [label="devolución para\nrevisión (CU-26)"];
DevueltaRevision -> dec [label="corrección\nregistrada (CU-84)"];
dec -> PendienteVerificacion [label="[cambios\ndocumentales]"];
dec -> PendienteEvaluacion [label="[etapa indicada:\nevaluación]"];
dec -> PendienteSeleccionPlan [label="[etapa indicada:\nselección de plan]"];
dec -> PendienteResolucion [label="[etapa indicada:\nresolución]"];
AprobadaPendienteLiquidacion -> Liquidada [label="desembolso\nconfirmado (CU-27)"];
AprobadaPendienteLiquidacion -> Vencida [label="vence la aprobación\n(CU-89, RN-49)"];
AprobadaPendienteLiquidacion -> PendienteEvaluacion [label="evaluación vencida o\ninvalidada (CU-89, RN-61)"];
PendienteSeleccionPlan -> PendienteEvaluacion [label="evaluación vencida o\ninvalidada (CU-89, RN-61)"];
PendienteResolucion -> PendienteEvaluacion [label="evaluación vencida o\ninvalidada (CU-89, RN-61)"];
PendienteDocumentacion -> Vencida [label="30 días sin movimiento\n(CU-89, RN-72)"];
DevueltaRevision -> Vencida [label="30 días sin movimiento\n(CU-89, RN-72)"];
PendienteVerificacion -> Cancelada [ltail=cluster_t, label="cancelación (CU-28)"];
Cancelada -> f1; Rechazada -> f2; Liquidada -> f3; Vencida -> f4;
}
