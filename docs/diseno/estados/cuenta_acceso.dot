digraph cuenta_acceso { rankdir=TB;
graph [fontname="Arial", fontsize=12, nodesep=0.5, ranksep=0.6, bgcolor=white];
node [fontname="Arial", fontsize=12, shape=box, style="rounded,filled", fillcolor="#DAE8FC", color="#6C8EBF", penwidth=1.5, height=0.45];
edge [fontname="Arial", fontsize=9, color="#333333", penwidth=1.2, arrowsize=0.8];
ini [shape=circle, style=filled, fillcolor=black, color=black, width=0.22, height=0.22, fixedsize=true, label=""];
ini -> PendienteActivacion [label="registro del usuario (CU-05)\no del cliente (CU-11)"];
PendienteActivacion -> Habilitada [label="contraseña definida con\nautorización válida (CU-04, CU-05)"];
Habilitada -> BloqueadaTemporalmente [label="5 intentos fallidos en 15 minutos\n(CU-01, CU-107; RN-62)"];
BloqueadaTemporalmente -> Habilitada [label="transcurren 15 minutos"];
Habilitada -> Desactivada [label="desactivación\n(CU-08, CU-13)"];
BloqueadaTemporalmente -> Desactivada [label="desactivación"];
Desactivada -> Habilitada [label="reactivación (CU-09) o\nrehabilitación (CU-04, RN-10)"];
}
