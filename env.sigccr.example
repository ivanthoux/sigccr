#--------------------------------------------------------------------
# SIG-CCR - Configuración de CodeIgniter (copiar como .env; no se versiona, RNF-04)
#--------------------------------------------------------------------
CI_ENVIRONMENT = development
# En producción: CI_ENVIRONMENT = production

app.baseURL = 'https://localhost/'
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# Base de datos: usuario de la aplicación (rol rol_sigccr_app)
#--------------------------------------------------------------------
database.default.hostname = db
database.default.database = sigccr
database.default.username = sigccr_app
database.default.password = Cambiar.App.2026
database.default.DBDriver = SQLSRV
database.default.port = 1433
database.default.schema = dbo
# La red entre contenedores es interna. Para cifrar la conexión (ODBC 18 lo exige con certificado de confianza),
# configurar un certificado TLS en SQL Server, agregarlo a la imagen app y poner encrypt = true (ver README).
database.default.encrypt = false
database.default.DBDebug = true

#--------------------------------------------------------------------
# Base de datos: propietario del esquema, solo para migraciones
#   php spark migrate --all -g migraciones
#--------------------------------------------------------------------
database.migraciones.hostname = db
database.migraciones.database = sigccr
database.migraciones.username = sigccr_owner
database.migraciones.password = Cambiar.Owner.2026
database.migraciones.DBDriver = SQLSRV
database.migraciones.port = 1433
database.migraciones.schema = dbo
database.migraciones.encrypt = false
database.migraciones.DBDebug = true

#--------------------------------------------------------------------
# Base de datos: mantenimiento de las copias de seguridad (CU-61 a CU-63, D-45)
# Lo crea docker/inicializar.sh, que también genera la contraseña si se deja vacía; lo usa solo el
# contenedor de procesos.
#--------------------------------------------------------------------
database.copias.hostname = db
database.copias.database = master
database.copias.username = sigccr_copias
database.copias.password =
database.copias.DBDriver = SQLSRV
database.copias.port = 1433
database.copias.encrypt = false
database.copias.DBDebug = true

#--------------------------------------------------------------------
# Cifrado (enlaces de autorizaciones en la cola de comunicaciones)
# Se genera con: php spark key:generate
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# SIG-CCR
#--------------------------------------------------------------------
sigccr.zonaNegocio = 'America/Argentina/Buenos_Aires'
sigccr.portalEnMantenimiento = false
# Adaptadores: 'simulador' en desarrollo y pruebas; 'real' con las credenciales del proveedor (RNF-05, RNF-08)
sigccr.adaptadorInformacionCrediticia = simulador
sigccr.adaptadorPasarela = simulador
sigccr.adaptadorComunicaciones = simulador
# Central de Deudores del BCRA (sigccr.adaptadorInformacionCrediticia = real): API pública, sin credenciales.
# Vacío usa https://api.bcra.gob.ar/CentralDeDeudores/v1.0. Espera de 10 s y 2 reintentos (RNF-08).
sigccr.informacionCrediticiaUrl =
sigccr.pasarelaToken =
sigccr.pasarelaSecretoNotificaciones =
# Correo real (sigccr.adaptadorComunicaciones = real): servidor SMTP del proveedor
sigccr.smtpHost =
sigccr.smtpPuerto = 587
sigccr.smtpCifrado = tls
sigccr.smtpUsuario =
sigccr.smtpClave =
sigccr.correoRemitente = no-responder@sigccr.local
# Correo de desarrollo con Mailpit (D-49): docker compose --profile correo up -d, y en lugar de las líneas anteriores
#   sigccr.adaptadorComunicaciones = real
#   sigccr.smtpHost = mailpit
#   sigccr.smtpPuerto = 1025
#   sigccr.smtpCifrado =
# Los correos se ven en http://localhost:8025. Las direcciones falla.transitoria@, falla.definitiva@ e incierto@ solo
# simulan errores con el simulador.

# Datos de la entidad para el contrato de préstamo (RN-78)
# sigccr.entidadRazonSocial = 'Financiera Ejemplo S.A.'
# sigccr.entidadCuit = '30712345678'
# sigccr.entidadDomicilio = 'Av. Siempre Viva 742, Posadas, Misiones'
