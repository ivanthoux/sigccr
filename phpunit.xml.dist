<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/codeigniter4/framework/system/Test/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <!-- Motor financiero: casos de referencia de RNF-15 -->
        <testsuite name="Finanzas">
            <directory>./tests/unit/Finanzas</directory>
        </testsuite>
        <!-- Lógica pura de todas las áreas (finanzas, seguridad, validación): no necesita la base -->
        <testsuite name="Unitarias">
            <directory>./tests/unit</directory>
        </testsuite>
        <!-- Autorización de cada ruta con cada rol (C10): usa la configuración de rutas, sin base de datos -->
        <testsuite name="Rutas">
            <directory>./tests/rutas</directory>
        </testsuite>
        <!-- Integración por campo y por clase de dato contra SQL Server (D-49): necesita la base sigccr_pruebas,
             que prepara tests/feature/preparar_base.sh. Se ejecuta con composer test:integracion. -->
        <testsuite name="Integracion">
            <directory>./tests/feature</directory>
        </testsuite>
        <!-- Todo lo que no necesita la base de datos -->
        <testsuite name="App">
            <directory>./tests</directory>
            <exclude>./tests/_local</exclude>
            <exclude>./tests/feature</exclude>
        </testsuite>
    </testsuites>
    <!-- El mínimo de 90 % de RNF-15 rige para el motor financiero. Los servicios (app/Services) necesitan la base de
         pruebas y se miden con las pruebas de integración de cada iteración, con su propio informe. -->
    <source>
        <include>
            <directory suffix=".php">./app/Libraries/Finanzas</directory>
        </include>
    </source>
    <php>
        <server name="app.baseURL" value="https://localhost/"/>
        <!-- Base de pruebas (D-49): las pruebas de integración usan el grupo "tests". Sin usuario propio, toma las
             credenciales de la aplicación (database.default.*), y en el entorno de pruebas todos los grupos apuntan a
             esta base (Config\Database). force="false": la integración continua puede definir otros valores. -->
        <env name="database.tests.hostname" value="db" force="false"/>
        <env name="database.tests.database" value="sigccr_pruebas"/>
        <env name="database.tests.DBDriver" value="SQLSRV"/>
    </php>
</phpunit>
