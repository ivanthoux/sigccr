{
    "name": "sigccr/sigccr",
    "description": "SIG-CCR - Sistema Integral de Gestión de Créditos, Cobranzas y Refinanciación",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-sqlsrv": "*",
        "codeigniter4/framework": "^4.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support",
            "Tests\\Unit\\": "tests/unit/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "test:finanzas": "phpunit -c phpunit.xml.dist --testsuite Finanzas --no-coverage",
        "cobertura": "@php -d pcov.enabled=1 vendor/bin/phpunit -c phpunit.xml.dist --testsuite Finanzas --coverage-text --coverage-html build/cobertura",
        "migrar": "SIGCCR_DB_GRUPO=migraciones php spark migrate --all",
        "semillas": "SIGCCR_DB_GRUPO=migraciones php spark db:seed SigccrSeeder",
        "cs": "phpcs",
        "stan": "phpstan analyse"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
